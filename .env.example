# Booth configuration. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit real values.

# --- Yahoo Fantasy API (developer app "Fantasy Football Weekly Report Agent") ---
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match the redirect URI registered on the Yahoo app exactly.
YAHOO_REDIRECT_URI=https://localhost:8000
# Where the OAuth access/refresh tokens are stored. secrets/ is gitignored.
YAHOO_TOKEN_FILE=secrets/yahoo_token.json

# --- League -------------------------------------------------------------------
YAHOO_LEAGUE_ID=890283
YAHOO_GAME_CODE=nfl

# --- Delivery -------------------------------------------------------------------
# Telegram (preferred): the token BotFather gave you for your Booth bot. Then run
# `uv run booth telegram-setup`, open the link it prints, tap Start, and run it again.
TELEGRAM_BOT_TOKEN=
# iMessage: phone number or Apple ID email. Used when Telegram isn't set up, and as the
# backup if a Telegram send fails.
IMESSAGE_RECIPIENT=
# Optional: force one channel (telegram, imessage, stdout).
# BOOTH_DELIVERY=

# --- Runtime ------------------------------------------------------------------
BOOTH_TIMEZONE=America/New_York
BOOTH_STATE_DIR=state
# 1 = practice mode: every report is sent with a [DRY RUN] prefix (Week 5)
BOOTH_DRY_RUN=1
